  "formula_sources": {
    "getVocationBase": "function getVocationBase(vocId) {\n                    if (vocId === 1 || vocId === 5) return 'sorcerer';\n                    if (vocId === 2 || vocId === 6) return 'druid';\n                    if (vocId === 3 || vocId === 7) return 'paladin';\n                    if (vocId === 4 || vocId === 8) return 'knight';\n                    return 'knight';\n                }",
    "getVocationGlobalDamageTuning": "function getVocationGlobalDamageTuning(vocation) {\n                    const baseVoc = vocation > 4 ? vocation - 4 : vocation;\n                    if (baseVoc === 4) return 1.58;  // Knight / Elite Knight     (+58% acumulado)\n                    if (baseVoc === 3) return 1.10;  // Paladin / Royal Paladin   (+10%)\n                    if (baseVoc === 1) return 0.85;  // Sorcerer / Master Sorcerer (-15%, 2026-08-02)\n                    // baseVoc === 2 (Druid / Elder Druid) cai aqui de propósito — intocado.\n                    return 1.0;\n                }",
    "getWeaponVocationDamageMultiplier": "function getWeaponVocationDamageMultiplier(vocation, weaponKind) {\n                    const baseVoc = vocation > 4 ? vocation - 4 : vocation;\n                    const tuning = getVocationGlobalDamageTuning(vocation);\n                    if ((baseVoc === 1 || baseVoc === 2) && weaponKind !== 'wand') return 0.35 * tuning;\n                    // Ajuste de balanceamento (2026-07-26): era 1.18, agora 1.18*0.95=1.121 — -5%\n                    // geral no golpe de arma do Paladin (arco/besta). Espelho em\n                    // idleWeaponVocationDamageMultiplier() no PHP; os dois têm que mudar juntos.\n                    // A fatia adicional de -10% pra alvo único (sem munição de área) é aplicada\n                    // separadamente em combatTick, perto de \"weaponDmg = applyCriticalDamage\".\n                    // Ajuste de balanceamento (2026-07-30): mais -5% geral em cima da base já\n                    // ajustada: 1.121*0.95=1.06495. Espelho em idleWeaponVocationDamageMultiplier()\n                    // no PHP.\n                    if (baseVoc === 3 && weaponKind === 'distance') return 1.06495 * tuning;\n                    // Ajuste de balanceamento (2026-07-26): tentamos 1.08*1.10=1.188 (+10%) e\n                    // ficou forte demais em teste — reduzido pra 1.08*1.05=1.134 (+5%) pra\n                    // continuar testando. Espelho em idleWeaponVocationDamageMultiplier() no\n                    // PHP; os dois têm que mudar juntos.\n                    // Ajuste de balanceamento (2026-07-28): redução geral de -4% no dano do\n                    // Knight/Elite Knight (pedido explícito do dono do projeto) —\n                    // 1.134*0.96=1.08864 e 0.55*0.96=0.528 (distância). Mexe no golpe de arma\n                    // normal E na família Exori (mesma base de skill*attack).\n                    // Ajuste de balanceamento (2026-07-28, mesma sessão): -4% não foi suficiente\n                    // em teste, subiu pra -8% geral sobre a base original — 1.134*0.92=1.04328 e\n                    // 0.55*0.92=0.506 (distância). Espelho de idleWeaponVocationDamageMultiplier()\n                    // no PHP; os dois têm que mudar juntos.\n                    if (baseVoc === 4 && ['sword', 'axe', 'club'].includes(weaponKind)) return 1.04328 * tuning;\n                    if (baseVoc === 4 && weaponKind === 'distance') return 0.506 * tuning;\n                    return 1.0 * tuning;\n                }",
    "getMaestriaElementsForVocation": "function getMaestriaElementsForVocation() {\n                    const voc = playerState.vocation > 4 ? playerState.vocation - 4 : playerState.vocation;\n                    if (voc === 1) return [{ id: 'fire', label: '🔥 Fogo' }, { id: 'energy', label: '⚡ Energia' }];\n                    if (voc === 2) return [{ id: 'ice', label: '❄️ Gelo' }, { id: 'earth', label: '🌿 Terra' }];\n                    return [];\n                }"
  }
}
